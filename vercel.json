{
  "rewrites": [
    {
      "source": "/prospeccao",
      "destination": "https://vertice-gmn.vercel.app/"
    },
    {
      "source": "/prospeccao/",
      "destination": "https://vertice-gmn.vercel.app/"
    },
    {
      "source": "/prospeccao/:path*",
      "destination": "https://vertice-gmn.vercel.app/:path*"
    },
    {
      "source": "/((?!assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
