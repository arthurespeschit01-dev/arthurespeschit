{
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "https://dycyskikaljvokaxsxnh.supabase.co/functions/v1/central-mcp?route=mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource/mcp",
      "destination": "https://dycyskikaljvokaxsxnh.supabase.co/functions/v1/central-mcp?route=resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "https://dycyskikaljvokaxsxnh.supabase.co/functions/v1/central-mcp?route=resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "https://dycyskikaljvokaxsxnh.supabase.co/functions/v1/central-mcp?route=authorization-server"
    },
    {
      "source": "/mcp/oauth/register",
      "destination": "https://dycyskikaljvokaxsxnh.supabase.co/functions/v1/central-mcp?route=register"
    },
    {
      "source": "/mcp/oauth/token",
      "destination": "https://dycyskikaljvokaxsxnh.supabase.co/functions/v1/central-mcp?route=token"
    },
    {
      "source": "/rastreio.js",
      "has": [
        {
          "type": "query",
          "key": "link",
          "value": "(?<trackingKey>[a-z0-9][a-z0-9-]{2,63})"
        }
      ],
      "destination": "https://dycyskikaljvokaxsxnh.supabase.co/functions/v1/workspace-operations?tracking_script=:trackingKey"
    },
    {
      "source": "/functions/v1/link-rastreavel/:trackingKey",
      "destination": "https://dycyskikaljvokaxsxnh.supabase.co/functions/v1/workspace-operations?link=:trackingKey"
    },
    {
      "source": "/prospeccao",
      "destination": "https://vertice-gmn.vercel.app/"
    },
    {
      "source": "/prospeccao/",
      "destination": "https://vertice-gmn.vercel.app/"
    },
    {
      "source": "/prospeccao/:path*",
      "destination": "https://vertice-gmn.vercel.app/:path*"
    },
    {
      "source": "/((?!assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/mcp/authorize",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
